generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(30)
  email        String   @unique @db.VarChar(255)
  passwordHash String
  avatarEmoji  String   @default("♠")
  chips        Int      @default(30000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  roomPlayers   RoomPlayer[]
  handActions   HandAction[]
  ranking       Ranking?

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Room {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(60)
  gameMode     String   @db.VarChar(20)  // 'tournament' | 'bomb_pot'
  bettingMode  String   @db.VarChar(10)  // 'NL' | 'PL'
  smallBlind   Int
  bigBlind     Int
  maxPlayers   Int      @default(6)
  startingStack Int     @default(30000)
  isPrivate    Boolean  @default(false)
  passwordHash String?
  status       String   @default("waiting") // 'waiting' | 'playing' | 'finished'
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  players RoomPlayer[]
  hands   Hand[]

  @@index([status])
  @@index([createdAt])
}

model RoomPlayer {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  seatIndex Int
  stack     Int
  isBot     Boolean  @default(false)
  joinedAt  DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, seatIndex])
  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Hand {
  id         String    @id @default(uuid())
  roomId     String
  handNumber Int
  gameState  Json      // final GameState snapshot at showdown
  hiWinnerId String?
  loWinnerId String?
  potAmount  Int
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  room    Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actions HandAction[]

  @@index([roomId])
  @@index([startedAt])
}

model HandAction {
  id         String   @id @default(uuid())
  handId     String
  userId     String
  phase      String   @db.VarChar(20)
  actionType String   @db.VarChar(20)
  amount     Int?
  createdAt  DateTime @default(now())

  hand Hand @relation(fields: [handId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([handId])
  @@index([userId])
}

model Ranking {
  id          String   @id @default(uuid())
  userId      String   @unique
  handsPlayed Int      @default(0)
  handsWon    Int      @default(0)
  hiWins      Int      @default(0)
  loWins      Int      @default(0)
  totalProfit Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
