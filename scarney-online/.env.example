# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/scarney"

# ─── JWT ────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-32chars-min"
JWT_REFRESH_SECRET="change-me-refresh-secret-32chars-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ─── Cookie ─────────────────────────────────────────────────
COOKIE_SECRET="change-me-cookie-secret"
