# ══════════════════════════════════════════════════════
#  AETHER BLACK v3.0 — 設定テンプレート
#  ※ 認証情報はダッシュボードの「Vault」から設定推奨
#     （AES-256-GCM 暗号化で data/vault/ に永続保存される）
#  ※ .env を直接使う場合: cp .env.example .env → 値を入力
# ══════════════════════════════════════════════════════

# ── Unity Publisher Portal ──────────────────────────
UNITY_EMAIL=
UNITY_PASSWORD=

# ── Fab.com (Epic Games) ────────────────────────────
FAB_EMAIL=
FAB_PASSWORD=

# ── AI 画像生成 API ──────────────────────────────────
# どちらか一方を設定 (stability 推奨: 8K ネイティブ対応)
STABILITY_API_KEY=
OPENAI_API_KEY=
GENERATION_PROVIDER=stability

# ── サポート情報 ─────────────────────────────────────
SUPPORT_EMAIL=support@yoursite.com
SUPPORT_URL=https://yoursite.com/support

# ── 予算管理 (USD) ───────────────────────────────────
BUDGET_MONTHLY_LIMIT_USD=50
BUDGET_ALERT_USD=40

# ── 生成設定 ─────────────────────────────────────────
IMAGES_PER_PACK=50
IMAGE_WIDTH=7680
IMAGE_HEIGHT=4320
QA_REQUIRE_EXACT_8K=false

# ── 実行設定 ─────────────────────────────────────────
HEADLESS=false
PORT=3000
