# ══════════════════════════════════════════════════════
#  AETHER BLACK v2.0 — マスター設定ファイル（唯一の .env）
#  使い方: cp .env.example .env → 値を入力して保存
#  ※ .env は .gitignore で管理。絶対にGitにコミットしない。
# ══════════════════════════════════════════════════════

# ── Unity Publisher Portal ──────────────────────────
UNITY_EMAIL=your-unity-email@example.com
UNITY_PASSWORD=your-unity-password

# ── Fab.com (Epic Games) ── ※近日対応予定 ──────────
FAB_EMAIL=
FAB_PASSWORD=

# ── アセット共通設定 ────────────────────────────────
ASSET_NAME=MyAssetPack
SUPPORT_EMAIL=support@yoursite.com
SUPPORT_URL=https://yoursite.com/support

# ── 実行設定 ────────────────────────────────────────
# false = ブラウザを表示（初期テスト推奨）
# true  = ヘッドレス（自動実行用）
HEADLESS=false

# ダッシュボードのポート番号
PORT=3000
