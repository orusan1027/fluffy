# ── Unity Publisher Portal 認証情報 ──────────────────────────────────────
# 絶対にこのファイルを .env にコピーしてから値を入力すること。
# .env は .gitignore に含まれており、Gitには絶対コミットされない。

UNITY_EMAIL=your-email@example.com
UNITY_PASSWORD=your-password-here

# ── アセット情報 ────────────────────────────────────────────────────────
# ポータルの下書きパッケージ名と完全一致させること（部分一致でも検索可能）
ASSET_NAME=MyAssetPack

# ── サポート情報 ────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@yoursite.com
SUPPORT_URL=https://yoursite.com/support

# ── 提出メッセージ（省略時は ASSET_NAME をもとに自動生成）───────────────
# SUBMISSION_MESSAGE=This package includes a pre-configured Demo Scene...

# ── 実行モード ─────────────────────────────────────────────────────────
# false = ブラウザUIを表示（初期テスト・デバッグ推奨）
# true  = ヘッドレス（CI/自動実行用）
HEADLESS=false
