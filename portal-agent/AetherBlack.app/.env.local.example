# DMM Affiliate API
# API ID is provided; Affiliate ID must be obtained from your DMM Affiliate dashboard.
DMM_API_ID=cdgQmb1gVWmvkDeL2mFE
DMM_AFFILIATE_ID=your-dmm-affiliate-id

# Fab.com Seller API — obtain your Bearer token from the Fab seller portal.
FAB_API_TOKEN=your-fab-api-token

# DLsite (estimated revenue — set manually or leave blank to use portal API)
# DLsite does not expose a public earnings API; use one of:
#   a) Set this env var directly (e.g. monthly estimate in JPY)
#   b) Provide PORTAL_BASE_URL + PORTAL_API_KEY to fetch from your portal's internal API
DLSITE_ESTIMATED_REVENUE_JPY=

# Portal API (漆黒ポータル — used by DLsite revenue fetch and crawler bridge)
PORTAL_BASE_URL=https://your-portal-url
PORTAL_ID=6
PORTAL_API_KEY=your-portal-api-key

# Path to Project_Ledger.json (relative to repo root)
LEDGER_PATH=portal-agent/Project_Ledger.json

# Exchange rate API (free, no key required by default)
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# Cache TTL in seconds for Next.js ISR revalidation (default: 3600 = 1 hour)
REVENUE_CACHE_TTL=3600
