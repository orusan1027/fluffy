# Crawler environment variables
# Copy to .env and fill in values.

# DMM / FANZA Affiliate API
DMM_API_ID=cdgQmb1gVWmvkDeL2mFE
DMM_AFFILIATE_ID=your-dmm-affiliate-id

# DLsite Affiliate
DLSITE_AFFILIATE_ID=your-dlsite-affiliate-id

# Target portal (漆黒ポータル)
PORTAL_BASE_URL=https://your-portal-url
PORTAL_ID=6
PORTAL_API_KEY=your-portal-api-key

# Ledger file path (relative to repo root)
LEDGER_PATH=portal-agent/Project_Ledger.json
